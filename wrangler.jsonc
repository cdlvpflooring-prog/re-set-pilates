// Cloudflare deployment settings. The site is a single-page app built into ./dist.
// Unknown paths (e.g. /he/schedule opened directly) fall back to index.html so the app's router handles them.
// Requests to /api/* run the Worker in worker/index.ts, which relays form data to Airtable.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "re-set-pilates",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Airtable base "Reset Pilates". The access token is a secret: set AIRTABLE_TOKEN in the Cloudflare dashboard.
    "AIRTABLE_BASE": "app0Wp3uV9jXJDAXZ"
  },
  // Per-visitor limit on form posts (each Cloudflare location counts separately).
  "ratelimits": [
    {
      "name": "FORM_LIMIT",
      "namespace_id": "4710",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
