// Cloudflare deployment settings. The site is a static single-page app built into ./dist.
// Unknown paths (e.g. /he/schedule opened directly) fall back to index.html so the app's router handles them.
// worker/index.ts runs for /api/* (forms → Airtable relay), /go/* (short links for flyers and QR codes)
// and the pages themselves (adds link-preview tags; files under /assets, /media, /icons are served directly).
// Secrets are not in this file: set AIRTABLE_TOKEN and TURNSTILE_SECRET in the dashboard (encrypted) or with `bunx wrangler secret put`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "re-set-pilates",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/go/*", "/r/*", "/", "/he", "/he/*", "/en", "/en/*"]
  },
  "routes": [
    { "pattern": "resetpilates.org", "custom_domain": true },
    { "pattern": "www.resetpilates.org", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    // Airtable base "Reset Pilates". The access token is a secret: set AIRTABLE_TOKEN in the Cloudflare dashboard.
    "AIRTABLE_BASE": "app0Wp3uV9jXJDAXZ"
  },
  // Per-visitor limit on form posts (each Cloudflare location counts separately). The WAF rule on /api/* sits in front of this.
  "ratelimits": [
    {
      "name": "FORM_LIMIT",
      "namespace_id": "4710",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Receipts by email: onboard resetpilates.org in Cloudflare Email Service (Email > Email Sending), then uncomment.
  // Without it the receipt still shows in the app and on its /r/ link; WhatsApp/SMS need their secrets (see worker/notify.ts).
  // "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
